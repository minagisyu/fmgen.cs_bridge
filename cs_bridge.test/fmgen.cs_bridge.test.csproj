<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsTestProject>true</IsTestProject>
    <StartupObject></StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.2" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\cs_bridge\fmgen.cs_bridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\runtimes\win-x64\native\fmgen.dll" Condition="Exists('..\\runtimes\\win-x64\\native\\fmgen.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\runtimes\linux-x64\native\libfmgen.so" Condition="Exists('..\\runtimes\\linux-x64\\native\\libfmgen.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\runtimes\linux-arm64\native\libfmgen.so" Condition="Exists('..\\runtimes\\linux-arm64\\native\\libfmgen.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\runtimes\linux-arm\native\libfmgen.so" Condition="Exists('..\\runtimes\\linux-arm\\native\\libfmgen.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\runtimes\osx-x64\native\libfmgen.dylib" Condition="Exists('..\\runtimes\\osx-x64\\native\\libfmgen.dylib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\runtimes\osx-arm64\native\libfmgen.dylib" Condition="Exists('..\\runtimes\\osx-arm64\\native\\libfmgen.dylib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
